# =============================================================================
# Docker production deploy
# =============================================================================
# Клонуйте репо, скопіюйте цей файл у .env і запустіть:
#   docker compose -f docker-compose.prod.yml up -d --build
# або: ./scripts/deploy.sh
#
# Стек: app (Node) + nginx (HTTPS, WebSocket) — все в Docker.
# Порти на хості: NGINX_HTTP_PORT (80), NGINX_HTTPS_PORT (443).
# Дані: Docker volume lab-data → /app/data у контейнері app.
# =============================================================================

# Домен для nginx і Let's Encrypt
DOMAIN=laboratorium.club
WWW_DOMAIN=www.laboratorium.club
CERTBOT_EMAIL=
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://laboratorium.club
SITE_URL=https://laboratorium.club
CONTACT_EMAIL=hello@laboratorium.club

# Cache busting — змінюйте при кожному деплої (або залиште порожнім = версія з package.json)
STATIC_VERSION=

# Security — ОБОВ'ЯЗКОВО задайте унікальний секрет (≥32 символів). Сервер не стартує з порожнім або відомим default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database (у Docker задається в compose: /app/data/laboratorium.db)
# SEED_DATABASE=false на проді — синхронізує лише каталог програм, без акаунтів
DATABASE_PATH=./data/laboratorium.db
SEED_DATABASE=false

# Реєстрація закрита — доступ тільки після оплати (власник створює акаунти)
ALLOW_PUBLIC_REGISTRATION=false

# Owner створюється лише якщо обидва значення задані І акаунта ще немає (пароль не перезаписується на рестарті)
OWNER_EMAIL=
OWNER_PASSWORD=

# Тестові акаунти — тільки локально, і тільки коли SEED_DATABASE=true (не production)
# TEST_STUDENT_EMAIL=test.student@lab.dev
# TEST_STUDENT_PASSWORD=
# TEST_TEACHER_EMAIL=test.teacher@lab.dev
# TEST_TEACHER_PASSWORD=

# Email (SMTP) — для скидання пароля та надсилання доступу
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@laboratorium.club

# CORS (через кому для кількох origin; у production — ваш домен, не *)
CORS_ORIGIN=https://laboratorium.club

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Auth
BCRYPT_ROUNDS=10
RESET_TOKEN_HOURS=24

# Proxmox — особиста VM для кожного учня (Лабораторія)
PROXMOX_ENABLED=false
PROXMOX_HOST=https://pve.example:8006
PROXMOX_TOKEN_ID=lab@pve!api-token
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve
PROXMOX_TEMPLATE_VMID=9000
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
LAB_VM_MEMORY_MB=4096
LAB_VM_CORES=2

# Lab Agent — Docker на окремій машині Proxmox (CTF + Docker вкладка)
LAB_AGENT_URL=http://127.0.0.1:3099
LAB_AGENT_SECRET=change-me-lab-agent-secret
LAB_DOCKER_HOST_IP=127.0.0.1
LAB_DOCKER_PORT_START=31000
LAB_DOCKER_PORT_END=32000

# Локальний Docker для CTF — розкоментуйте docker.sock у docker-compose.prod.yml (app)
LAB_USE_LOCAL_DOCKER=false
CTF_DOCKER_IMAGE=laboratorium/ctf-lab:latest

# Щомісячна оплата курсів
BILLING_GRACE_DAYS=4
BILLING_DEFAULT_DAY=1

# Публічний доступ учнів — sslip.io + безпечний HTTPS-тунель
LAB_USE_SSLIP=true
LAB_SSLIP_DOMAIN=sslip.io
LAB_SECURE_TUNNEL=true
# Публічний IP шлюзу (sslip DNS → цей IP, зазвичай IP сервера laboratorium)
LAB_TUNNEL_GATEWAY_IP=203.0.113.10
LAB_TUNNEL_TOKEN_HOURS=72
LAB_PUBLIC_SCHEME=https
LAB_VM_SSH_USER=lab
LAB_VM_SSH_PORT=22
